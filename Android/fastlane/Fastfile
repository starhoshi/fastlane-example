# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Google Play に新しいビルドを提出する"
  desc "バージョン名は変更しない。versionCode だけを採番する。"
  desc "versionCode は epoch 秒。ANDROID_VERSION_CODE を設定するとその値を使う。"
  desc "ANDROID_BUILD_COMMAND でビルドする。既定は flutter build appbundle --release。"
  desc "空文字を渡すとビルドせず、既にある aab をアップロードする。"
  desc "./gradlew bundleRelease などに差し替えれば素の Android / Expo でも動く。"
  desc "upload_to_play_store で aab とメタデータをアップロードする。"
  desc "任意: SUPPLY_TRACK（既定 production）/ SUPPLY_AAB / SUPPLY_RELEASE_STATUS（既定 draft）"
  desc "任意: SUPPLY_SKIP_UPLOAD_METADATA / _CHANGELOGS / _IMAGES / _SCREENSHOTS（'true' で skip）"
  lane :deploy do
    # ビルドコマンドは差し替えられる。
    #
    # 既定は Flutter なので、**環境変数を設定しなければ以前とまったく同じ挙動**。
    # Flutter のアプリ側は何も変えなくてよい。
    #
    #   ANDROID_BUILD_COMMAND=""                        → ビルドせず、出来ている aab を上げるだけ
    #   ANDROID_BUILD_COMMAND="./gradlew bundleRelease"  → 素の Android / Expo など
    #
    # build number に epoch 秒を使うのは、Play が「前より大きい versionCode」を
    # 要求するから。手で採番すると必ずどこかで重複させる。
    # 外から与えたいときは ANDROID_VERSION_CODE を設定する。
    version_code = ENV['ANDROID_VERSION_CODE'] || Time.now.to_i.to_s
    build_command = ENV.fetch('ANDROID_BUILD_COMMAND') do
      "flutter build appbundle --release --build-number=#{version_code}"
    end
    sh(build_command) unless build_command.to_s.strip.empty?

    # 環境変数から設定を読み込んでアップロード
    upload_to_play_store(
      track: ENV['SUPPLY_TRACK'] || 'production',
      aab: ENV['SUPPLY_AAB'] || "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: ENV['SUPPLY_SKIP_UPLOAD_METADATA'] == 'true',
      skip_upload_changelogs: ENV['SUPPLY_SKIP_UPLOAD_CHANGELOGS'] == 'true',
      skip_upload_images: ENV['SUPPLY_SKIP_UPLOAD_IMAGES'] == 'true',
      skip_upload_screenshots: ENV['SUPPLY_SKIP_UPLOAD_SCREENSHOTS'] == 'true',
      release_status: ENV['SUPPLY_RELEASE_STATUS'] || 'draft'
    )
  end
end
