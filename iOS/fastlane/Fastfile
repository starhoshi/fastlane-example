fastlane_version "2.19.2"

default_platform :ios

import_from_git(
  url: 'https://github.com/classi/fastlane-example',
  path: 'Util/Fastfile'
)

private_lane :reset_build do
  # build_id 更新などで差分が出る project.pbxproj と Info.plist を復元する
  sh('cd "$(git rev-parse --show-toplevel)" && git ls-files | grep -E "(project\\.pbxproj|Info\\.plist)$" | while read -r f; do git restore --staged --worktree -- "$f"; done; true')
end

private_lane :next_ios_build_number do |options|
  version = options[:version] || get_version_number
  base = Time.now.strftime("%Y%m%d0000").to_i

  begin
    latest = latest_testflight_build_number(
      api_key: options[:api_key],
      version: version,
      initial_build_number: base - 1
    )
    latest_i = latest.to_i
    (latest_i >= base ? latest_i + 1 : base).to_s
  rescue => error
    UI.user_error!("App Store Connect から build 番号取得に失敗したため終了します: #{error.message}")
  end
end

private_lane :upload_dsyms_to_crashlytics_if_configured do
  configured_gsp_path = ENV['GOOGLE_SERVICES_INFO_PLIST_PATH'].to_s.strip

  if configured_gsp_path.empty?
    UI.important("GOOGLE_SERVICES_INFO_PLIST_PATH が未設定のため Crashlytics への dSYM upload を skip します")
    next
  end

  # lane は fastlane/ で実行されるため、各パスをプロジェクトルート基準の絶対パスへ変換する
  project_root = File.expand_path('..', Dir.pwd)
  gsp_path = File.expand_path(configured_gsp_path, project_root)
  binary_path = File.join(project_root, 'scripts', 'upload-symbols')
  dsym_path = Actions.lane_context[SharedValues::DSYM_OUTPUT_PATH]

  UI.user_error!("GoogleService-Info.plist が見つかりません: #{gsp_path}") unless File.file?(gsp_path)
  UI.user_error!("upload-symbols が見つからないか実行できません: #{binary_path}") unless File.executable?(binary_path)
  UI.user_error!("gym が生成した dSYM が見つかりません: #{dsym_path}") if dsym_path.to_s.empty? || !File.exist?(dsym_path)

  UI.message("Crashlytics へ dSYM をアップロードします: #{dsym_path}")
  upload_succeeded = system(binary_path, '-gsp', gsp_path, '-p', 'ios', dsym_path)
  UI.user_error!("Crashlytics への dSYM upload に失敗しました") unless upload_succeeded
  UI.success("Crashlytics への dSYM upload が完了しました")
end

# TestFlight の「テスト項目」(What to Test) に文言を入れる。
#
# deliver が触るのは App Store の「新機能」だけで、TestFlight の欄は
# betaBuildLocalizations という別のリソースなので、deliver では埋まらない。
# distribute_only は ipa を上げずに既存ビルドのメタ情報だけ更新するモードで、
# skip_submission を付ければ外部テスターへの配布も通知も起きない
# (pilot の distribute は update_beta_app_meta を呼んだ後に return する)。
#
# release lane 用。testflight lane は upload_to_testflight に changelog を
# 直接渡せるので、こちらを通す必要はない。
private_lane :set_testflight_changelog do |options|
  changelog = options[:changelog].to_s

  if changelog.strip.empty?
    UI.important("TestFlight のテスト項目に入れる文言が空のため skip します")
    next
  end

  upload_to_testflight(
    api_key: options[:api_key],
    distribute_only: true,
    app_version: get_version_number,
    build_number: get_build_number,
    changelog: changelog,
    # 文言を書くだけ。外部テスターへの配布はしない
    skip_submission: true
  )
end

# App Store Connect 上のスクリーンショットを重複ごとに 1 枚へ整理する。
#
# deliver はアップロード直後の検証で「まだ App Store Connect 側に見えない」
# スクショを未アップロード扱いにして再送するため、実際には上がっていたものが
# 二重に並ぶことがある。発生するのは新しいスクショを上げたときだけなので、
# 上げていない実行では触らない。
#
# 判定に source_file_checksum は使えない。処理が終わるまで nil のことがあり、
# 同じ画像でもキーが割れてしまうため、ファイル名で見る。
platform :ios do
  changelog = ""
  default_payloads = [:lane, :test_result, :git_branch, :git_author]

  before_all do
    changelog = changelog_from_git_commits_hs
  end


  desc "Runs all the tests"
  lane :test do
    scan
    xcov(
      workspace: ENV["XCOV_WORKSPACE"],
      scheme: ENV["XCOV_SCHEME"],
      exclude_targets: ENV["XCOV_EXCLUDE_TARGETS"]
    )
    danger
  end


  # TestFlight のテスト項目に載せる文言を組み立てる。
  #
  # release lane は「App Store のリリースノート + コミットログ」、
  # testflight lane はコミットログだけ。テスターが知りたいのは
  # 「今回何が変わったか」なので、両方あるときは続けて並べる。
  def testflight_changelog(commit_log, with_release_notes: false)
    parts = []
    parts << app_store_release_notes if with_release_notes
    parts << commit_log
    parts.compact.map(&:strip).reject(&:empty?).join("\n\n")
  end

  # deliver が読むのと同じ metadata/<locale>/release_notes.txt を読む。
  # lane の中は cwd が fastlane/ なので、そこからの相対で探す。
  #
  # 読めなくてもテスト項目がコミットログだけになるだけなので、
  # ここでは落とさず nil を返す。リリースを止める理由にはならない。
  def app_store_release_notes
    locales = [ENV["TESTFLIGHT_NOTES_LOCALE"], "ja", "en-US"].compact.reject(&:empty?)
    path = locales.map { |locale| "metadata/#{locale}/release_notes.txt" }.find { |candidate| File.file?(candidate) }
    path ||= Dir.glob("metadata/*/release_notes.txt").sort.first
    return nil unless path && File.file?(path)

    File.read(path)
  rescue => error
    UI.important("リリースノートを読めませんでした (#{error.message})。TestFlight のテスト項目はコミットログだけにします")
    nil
  end

  def screenshot_app_identifier
    CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
  end

  # Deliverfile の skip_screenshots を読む。deliver アクション自身と同じ手順で
  # 組み立てるので、実際に deliver が使う値と一致する。
  # 読めなかったときは「上げていない」側に倒す。判定できないだけで審査の提出を
  # 取り下げてしまうより、何もしない方が安全なため。
  def deliver_skip_screenshots?
    require 'deliver'
    config = FastlaneCore::Configuration.create(Deliver::Options.available_options, {})
    # レーンの中は cwd が fastlane/ だが、アクションは runner が Dir.chdir("..") して
    # から呼ぶので、deliver 本体はリポジトリ直下で Deliverfile を読む。ここも合わせる。
    # 揃えないと、Deliverfile に書かれた相対パス (app_rating_config_path など) だけが
    # 解決に失敗して、skip_screenshots の判定ごと rescue に落ちる。
    Dir.chdir("..") { config.load_configuration_file("Deliverfile") }
    config[:skip_screenshots]
  rescue => error
    UI.important("Deliverfile の skip_screenshots を判定できませんでした (#{error.message})。スクショの重複チェックを skip します")
    true
  end

  # App Store Connect 上で重複しているスクリーンショットを列挙する。
  #
  # deliver はアップロード直後の検証で「まだ App Store Connect 側に見えない」
  # スクショを未アップロード扱いにして再送するため、実際には上がっていたものが
  # 二重に並ぶことがある。発生するのは新しいスクショを上げたときだけ。
  #
  # 判定に source_file_checksum は使えない。処理が終わるまで nil のことがあり、
  # 同じ画像でもキーが割れてしまうため、ファイル名で見る。
  def each_duplicate_screenshot
    app_identifier = screenshot_app_identifier
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("App が見つかりません: #{app_identifier}") unless app

    # get_edit_app_store_version のフィルタには WAITING_FOR_REVIEW も含まれるので、
    # 審査に出した後でも読める。つまり self reject する前に重複の有無を判定できる。
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("編集中のバージョンが見つかりません") unless version

    version.get_app_store_version_localizations.each do |localization|
      localization.get_app_screenshot_sets.each do |set|
        seen = {}
        (set.app_screenshots || []).each do |screenshot|
          key = screenshot.file_name
          if seen[key]
            yield(localization, set, screenshot)
          else
            seen[key] = true
          end
        end
      end
    end
  end

  def duplicate_screenshots?
    each_duplicate_screenshot { return true }
    false
  end

  # 審査提出の取り下げは API が 200 を返したあとも Apple 側で少し遅れて効く。
  # 効く前に消しにいくと "Can't Delete Screenshot After Submit for review" で
  # 弾かれるので、消せるようになるまで待ってから諦める。
  # (実測で取り下げの 2 秒後は間に合わず、1 分後には通っていた)
  SCREENSHOT_DELETE_ATTEMPTS = 8
  SCREENSHOT_DELETE_INTERVAL = 10

  def delete_screenshot_with_retry(screenshot)
    attempt = 0
    begin
      attempt += 1
      screenshot.delete!
    rescue Spaceship::UnexpectedResponse => error
      # 取り下げ待ち以外 (権限、既に消えている等) は素直に投げる
      raise unless error.message.include?("Can't Delete Screenshot")
      raise if attempt >= SCREENSHOT_DELETE_ATTEMPTS

      UI.important(
        "審査提出の取り下げがまだ効いていません。#{SCREENSHOT_DELETE_INTERVAL} 秒待って再試行します " \
        "(#{attempt}/#{SCREENSHOT_DELETE_ATTEMPTS - 1})"
      )
      sleep(SCREENSHOT_DELETE_INTERVAL)
      retry
    end
  end

  def remove_duplicate_screenshots
    removed = 0
    each_duplicate_screenshot do |localization, set, screenshot|
      UI.important("重複を削除: #{localization.locale} #{set.screenshot_display_type} #{screenshot.file_name}")
      delete_screenshot_with_retry(screenshot)
      removed += 1
    end

    if removed.zero?
      UI.success("重複したスクリーンショットはありませんでした")
    else
      UI.success("重複したスクリーンショットを #{removed} 件削除しました")
    end
    removed
  end

  desc "App Store に新しいビルドを提出する"
  desc "バージョン番号は変更しない。get_version_number で読むだけ。"
  desc "ビルド番号は YYYYMMDD0000 を基準に採番し、TestFlight の最新がそれ以上なら +1 する。"
  desc "match(appstore) で証明書とプロビジョニングを取得し、gym でビルドする。"
  desc "GOOGLE_SERVICES_INFO_PLIST_PATH が設定されていれば dSYM を Crashlytics へ上げる。未設定なら skip。"
  desc "deliver で ipa とメタデータをアップロードする。"
  desc "スクリーンショットを上げた実行に限り重複を検査し、見つかったら self reject して出し直す。"
  desc "v<version> タグを削除してから force で打ち直して push するので、同じバージョンで複数回実行するとタグは常に最新のコミットを指す。"
  desc "完了時に Slack へ通知する。"
  desc "必須: ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT / RELEASE_GYM_SCHEME"
  desc "任意: GOOGLE_SERVICES_INFO_PLIST_PATH / SLACK_CHANNEL / GITHUB_REPOSITORY"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'], 
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
    )
    
    match(type: "appstore")

    # Update build number
    increment_build_number(
      build_number: next_ios_build_number(api_key: api_key)
    )

    # Compile
    gym(scheme: ENV["RELEASE_GYM_SCHEME"])

    # Upload dSYM to Crashlytics before changing App Store Connect state
    upload_dsyms_to_crashlytics_if_configured

    # Upload ipa to iTunes Connect
    deliver

    # Get diff from the last tag
    # タグの message と TestFlight のテスト項目で同じものを使うので、先に取っておく。
    # この実行で打つタグがローカルに残っていると last_git_tag がそれを指して
    # 差分が空になるため、消してから取る。
    sh("git tag -d v#{get_version_number} || echo")
    diff = git_tag_diff

    # TestFlight のテスト項目を埋める。deliver は App Store の「新機能」しか
    # 書かないので、ここでビルドのメタ情報だけ後から更新する。
    # deliver がビルドの処理完了まで待った後なので、対象のビルドは必ず存在する。
    #
    # 最新 1 コミットではなく前のタグからの差分を載せる。release のいちばん新しい
    # コミットはたいていバージョンを上げただけのもので、中身が分からないため。
    set_testflight_changelog(
      api_key: api_key,
      changelog: testflight_changelog(diff, with_release_notes: true)
    )

    # スクショを上げた実行でだけ重複が生まれる。上げていないなら審査状態に触らない。
    # 重複があるときだけ self reject するので、無駄に審査の順番待ちを捨てずに済む。
    if !deliver_skip_screenshots?
      if duplicate_screenshots?
        fix_screenshots
      else
        UI.success("重複したスクリーンショットはありませんでした")
      end
    end

    # Create git tag
    # Force pushing because it may create the same tag more than once.
    add_git_tag(
      tag: "v#{get_version_number}",
      message: "build_number: #{get_build_number} by fastlane\n\n#{diff}",
      force: true
    )
    push_git_tags(force: true)

    # notify slack
    payload = {"Git Commit" => changelog}
    payload["Repo"] = ENV["GITHUB_REPOSITORY"] if ENV["GITHUB_REPOSITORY"]
    slack(
      channel: ENV["SLACK_CHANNEL"],
      message: ":itunesconnect: Successfully uploaded a new App Store build",
      payload: payload,
      default_payloads: default_payloads
    )
  end

  desc "App Store Connect 上の重複したスクリーンショットを削除して審査に出し直す"
  desc "release がスクショを上げた回に、重複が見つかったときだけ自動で呼ばれる。"
  lane :fix_screenshots do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT']
    )

    # release が既にスクショを上げた後に呼ばれるので、ここでは上げ直さない
    common = {
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    }

    # 審査待ちのままだとスクショを消せないので、まず提出を取り下げる
    deliver(common.merge(reject_if_possible: true, submit_for_review: false))

    # 掃除に失敗しても審査には必ず戻す。ここで抜けると「取り下げたまま
    # 出し直していない」状態で止まり、誰も気づかないまま審査に並ばない。
    # 重複が残るのは見た目の問題だが、並んでいないのはリリースが進まない
    begin
      remove_duplicate_screenshots
    ensure
      deliver(common.merge(reject_if_possible: false, submit_for_review: true))
    end
  end

  desc "TestFlight にだけビルドを上げる"
  desc "バージョン番号は変更しない。ビルド番号は release と同じ規則で採番する。"
  desc "match(appstore) で証明書を取得し、gym でビルドして upload_to_testflight で上げる。"
  desc "GOOGLE_SERVICES_INFO_PLIST_PATH が設定されていれば dSYM を Crashlytics へ上げる。"
  desc "App Store の審査には提出しない。git タグも打たない。"
  desc "完了時に Slack へ通知する。"
  desc "必須: ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT / RELEASE_GYM_SCHEME"
  lane :testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
    )

    match(type: "appstore")

    # Update build number
    increment_build_number(
      build_number: next_ios_build_number(api_key: api_key)
    )

    # Compile
    gym(scheme: ENV["RELEASE_GYM_SCHEME"])

    # Upload dSYM to Crashlytics before changing App Store Connect state
    upload_dsyms_to_crashlytics_if_configured

    # Upload to TestFlight
    # changelog がそのままテスト項目 (What to Test) になる
    upload_to_testflight(api_key: api_key, changelog: testflight_changelog(changelog))

    # notify slack
    payload = {"Git Commit" => changelog}
    payload["Repo"] = ENV["GITHUB_REPOSITORY"] if ENV["GITHUB_REPOSITORY"]
    slack(
      channel: ENV["SLACK_CHANNEL"],
      message: ":testflight: Successfully uploaded a new TestFlight build",
      payload: payload,
      default_payloads: default_payloads
    )
  end
  error do |lane, exception|
    # Reset iOS directory changes on error
    reset_build

    payload = {}
    payload["Repo"] = ENV["GITHUB_REPOSITORY"] if ENV["GITHUB_REPOSITORY"]
    slack(
      channel: ENV["SLACK_CHANNEL"],
      message: exception.message,
      success: false,
      payload: payload
    )
  end


  after_all do
    reset_build
  end
end
